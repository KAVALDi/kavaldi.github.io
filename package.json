  "type": "module",
  "bugs": {
    "url": "https://github.com/KAVALDi/kavaldi.github.io/issues"
  },
  "homepage": "https://github.com/KAVALDi/kavaldi.github.io#readme",
  "dependencies": {
    "markdown-it": "^14.3.3",
    "yaml": "^2.9.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
