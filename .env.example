# Пример настроек окружения. Скопируйте в .env только то, что нужно; сам .env в Git не попадает.
# Значения секретов сюда НЕ записывать.

# Путь к приватному хранилищу знаний (по умолчанию ../knowledge рядом с репозиторием).
# То же можно задать в hub.local.json: { "store": "D:/knowledge" }
HUB_STORE=

# Токен GitHub для календаря активности и сверки PR. Не нужен, если установлен и авторизован gh.
# Достаточно прав на чтение публичных данных.
GITHUB_TOKEN=

# AI-провайдер. Сейчас поддерживается только none: ядро работает без AI.
HUB_AI_PROVIDER=none

# Базовый путь сайта. Для https://kavaldi.github.io/ это "/".
SITE_BASE=/
